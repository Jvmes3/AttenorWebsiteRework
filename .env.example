# Supabase project settings. Never expose the service-role key in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-server-secret-key

# Transactional lead confirmations. Verify attenorcollab.com with Resend first.
RESEND_API_KEY=re_replace-with-resend-api-key
LEAD_CONFIRMATION_FROM=Attenor Collaborative <hello@attenorcollab.com>
ATTENOR_SCHEDULER_URL=https://calendly.com/attenorcollab

# HTTPS endpoint from a deployed Google Apps Script that appends each JSON payload to a Sheet.
LEAD_SPREADSHEET_WEBHOOK_URL=https://script.google.com/macros/s/replace-with-deployment-id/exec

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

# Must be a one-line JSON array with one or more account objects.
# Generate each passwordHash with: npm run hash-password
ATTENOR_ACCOUNTS_JSON=[{"username":"client-one","displayName":"Client One","passwordHash":"scrypt$SALT$HASH","documents":[{"id":"impact-report","title":"Impact Report","description":"Your private impact report.","storagePath":"client-one/impact-report.pdf","filename":"impact-report.pdf"}]}]
