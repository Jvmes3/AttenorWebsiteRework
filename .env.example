# Supabase project settings. Never expose the service-role key in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-server-secret-key

# Transactional lead confirmations. Verify attenorcollab.com with Resend first.
RESEND_API_KEY=re_replace-with-resend-api-key
LEAD_CONFIRMATION_FROM=Attenor Collaborative <hello@attenorcollab.com>
ATTENOR_SCHEDULER_URL=https://calendly.com/attenorcollab

# HTTPS endpoint from a deployed Google Apps Script that appends each JSON payload to a Sheet.
LEAD_SPREADSHEET_WEBHOOK_URL=https://script.google.com/macros/s/replace-with-deployment-id/exec

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

# Must be a one-line JSON array with one or more account objects.
# Generate each passwordHash with: npm run hash-password
ATTENOR_ACCOUNTS_JSON=[{"username":"client-one","displayName":"Client One","passwordHash":"scrypt$SALT$HASH","documents":[{"id":"impact-report","title":"Impact Report","description":"Your private impact report.","storagePath":"client-one/impact-report.pdf","filename":"impact-report.pdf"}]}]

# Portal and Assessment Studio: all values below are server-only.
# SUPABASE_URL and SUPABASE_SECRET_KEY above serve persistent portal tables as well
# as the website's existing lead storage. Run supabase/portal-setup.sql first.
# Test records use environment=test; production records use environment=production.
# Keep SESSION_SECRET stable across all Vercel functions and deployments that share logins.

# npm run dev enables test mode. Vercel auto-enables it only for the exact combination
# VERCEL_ENV=preview and VERCEL_GIT_COMMIT_REF=test-production (provided by Vercel).
# A Production deployment never accepts this preview flag as test authorization.
# Outside that named Vercel branch, this optional flag enables test mode locally/in Preview.
# ATTENOR_ASSESSMENT_PREVIEW=1

# Production student accounts are disabled until this is explicitly enabled.
# ATTENOR_PORTAL_STUDENTS_ENABLED=1

# Production: shared facilitator password hash (npm run hash-password).
# The test-only fallback password is Facilitator26!; do not use it for a live engagement.
# ATTENOR_ASSESSMENT_ADMIN_PASSWORD_HASH=scrypt$SALT$HASH

# Optional initial session metadata/password hashes; one-line JSON array.
# Session management also saves newly created sessions in portal_assessment_sessions.
# Benchmark 2 stays unavailable until its separate assessment content is reviewed.
# ATTENOR_ASSESSMENT_SESSIONS_JSON=[{"id":"wayman-benchmark-1","slug":"benchmark-1","name":"Science - Benchmark 1","organization":"Wayman Academy of Arts","type":"benchmark","benchmark":1,"status":"open","passwordHash":"scrypt$SALT$HASH"}]

# Ronetta's separate Wayman question bank. These credentials belong only on the server.
# Test Benchmark 1 can use the supplied question-only snapshot when this is not configured.
# WAYMAN_SUPABASE_URL=https://your-wayman-project.supabase.co
# WAYMAN_SUPABASE_KEY=replace-with-key-authorized-for-the-required-operations

# Optional direct-to-Wayman production submission integration, separate from portal storage.
# See README for the exact RPC input/receipt contract. The function must authorize,
# grade and save atomically, and deduplicate submission IDs before it is enabled.
# WAYMAN_SUBMIT_RPC=submit_wayman_assessment
